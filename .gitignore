# Dependencies
node_modules/

# Frontend build artifacts
dist/
coverage/
.vite/
*.tsbuildinfo

# Auto-built SPA static files (built by `jiandou serve`)
static/web/assets/
static/web/index.html
static/web/vite.svg

# Java build artifacts
target/
*.class

# Local runtime storage
storage/

# Local environment
.env
.env.*
!.env.*.example

# Logs and process files
*.log
*.pid
*.seed
*.pid.lock
logs/

# Python caches and virtualenvs
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/

# IDE and OS files
.DS_Store
.idea/
.vscode/*
