!.vscode/settings.json

# Generated OpenAPI artifact (derive from running backend via npm run generate:api)
docs/openapi.json

# Local AI/tooling state
.claude/
.codex/

# Database files
data/*.db
data/*.db-journal

# Secrets (API keys)
config/secrets/
