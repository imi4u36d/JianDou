TZ=Asia/Shanghai

# App
JIANDOU_APP_ENV=dev
JIANDOU_EXECUTION_MODE=queue
# Container-internal listener. Map host ports with `docker run -p`.
JIANDOU_SERVER_ADDRESS=0.0.0.0
JIANDOU_SERVER_PORT=8000
JIANDOU_AUTO_MIGRATE=true

# Database
JIANDOU_DATABASE_URL=sqlite+aiosqlite:///./data/jiandou.db

# Web / cookies
JIANDOU_WEB_ORIGIN=http://127.0.0.1:8100
JIANDOU_TRUSTED_ORIGINS=http://localhost:8100
JIANDOU_COOKIE_SECURE=false
JIANDOU_PUBLIC_API_BASE_URL=/api/v3
JIANDOU_PUBLIC_STORAGE_BASE_URL=/storage
JIANDOU_PUBLIC_ADMIN_BASE_URL=/admin
JIANDOU_STORAGE_PUBLIC_BASE_URL=

# Auth / security
JIANDOU_SECRET_KEY=change-me-to-a-real-secret
JIANDOU_BOOTSTRAP_ADMIN_USERNAME=admin
JIANDOU_BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
JIANDOU_BOOTSTRAP_ADMIN_PASSWORD=admin123
JIANDOU_AUTH_INVITE_EXPIRY_HOURS=12
JIANDOU_AUTH_LOGIN_RATE_LIMIT=10
JIANDOU_AUTH_INVITE_ACTIVATION_RATE_LIMIT=5
JIANDOU_AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Storage
JIANDOU_STORAGE_ROOT=./storage
JIANDOU_UPLOADS_DIR=uploads
JIANDOU_GENERATION_RUNS_DIR=gen/_runs

# Worker
JIANDOU_GENERATION_ASYNC_THREADS=2
JIANDOU_WORKER_CONCURRENCY=2
JIANDOU_WORKER_STALE_TIMEOUT_SECONDS=30
JIANDOU_WORKER_POLL_INTERVAL_MS=1000

# Task defaults
JIANDOU_SOURCE_FILE_NAME=text_prompt
JIANDOU_DEFAULT_ASPECT_RATIO=16:9
JIANDOU_DEFAULT_DURATION_SECONDS=8
JIANDOU_EDITING_MODE=drama
JIANDOU_INTRO_TEMPLATE=none
JIANDOU_OUTRO_TEMPLATE=none

# Optional model overrides. Platform API keys should normally live in:
# config/model/providers.secrets.yml
# See config/model/providers.secrets.example.yml.
# JIANDOU_MODEL_API_KEY=
# JIANDOU_MODEL_BASE_URL=
