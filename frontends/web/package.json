{
  "name": "@jiandou/web",
  "version": "0.2.0-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{vue,ts,css,html,json}\"",
