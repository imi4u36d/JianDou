{
  "name": "@jiandou/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint src --ext .vue,.ts",
    "format": "prettier --write \"src/**/*.{vue,ts,css,html,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@jiandou/api": "file:../../packages/api",
    "@jiandou/domain": "file:../../packages/domain",
    "@jiandou/ui": "file:../../packages/ui",
    "element-plus": "^2.9.8",
    "vue": "^3.4.38",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-vue": "^4.6.2",
    "@vitest/coverage-v8": "^1.6.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.30.0",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.49",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^4.5.5",
    "vitest": "^1.6.0",
    "vue-tsc": "^2.1.10"
  }
}
